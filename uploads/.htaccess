Options -Indexes

# Folder uploads hanya untuk aset statis. Jangan pernah eksekusi script dari sini.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pl .py .cgi .asp .aspx .jsp .shtml .html .htm
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pl .py .cgi .asp .aspx .jsp .shtml .html .htm

<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|jsp|asp|aspx|htm|html|shtml|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
